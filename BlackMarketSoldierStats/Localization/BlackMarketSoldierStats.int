[BlackMarketSoldierStats_Settings]

SettingsPage_Label = Black Market Soldier Stats
PageTitle_Label = Black Market Soldier Stats
GroupGeneralSettings_Label = General Settings
UISettings_Label = UI Settings

HIGHLIGHT_ABOVE_BELOW_AVERAGE_Label="Highlight above/below average stats"
HIGHLIGHT_ABOVE_BELOW_AVERAGE_Tip="If activated, highlights below average stats in red and above average stats in green."

STAT_DISPLAY_MODE_Label="Stat display mode"
STAT_DISPLAY_MODE_Tip="Show stat as absolute, delta (relative difference adjusted to rank), or as combination of both."
STAT_DISPLAY_MODE_Strings[0]="Absolute"
STAT_DISPLAY_MODE_Strings[1]="Delta"
STAT_DISPLAY_MODE_Strings[2]="Combined"

PSI_OFFENSE_REQUIRE_SECTOID_AUTOPSY_Label="Require Sectoid autopsy for Psi Offense stat"
PSI_OFFENSE_REQUIRE_SECTOID_AUTOPSY_Tip="Require the Sectoid autopsy to be completed before displaying the Psi Offense stat. Intended mainly for Long War of the Chosen players to get a behaviour consistent with how the display of the stat is handled there."

PANEL_X_Label="Stats panel location: X"
PANEL_X_Tip="The X (left/right) coordinate of where the top-left corner of the stats panel should be rendered."

PANEL_Y_Label="Stats panel location: Y"
PANEL_Y_Tip="The Y (up/down) coordinate of where the top-left corner of the stats panel should be rendered."

REVEAL_COST_ENABLED_Label="Revealing stats should cost something"
REVEAL_COST_ENABLED_Tip="Soldier stats will only be revealed after the configured cost is paid."

REVEAL_COST_RESOURCE_Label="Reveal cost: Resource"
REVEAL_COST_RESOURCE_Tip="Resource that is required to be paid for revealing soldier stats."

REVEAL_COST_QUANTITY_Label="Reveal cost: Quantity"
REVEAL_COST_QUANTITY_Tip="How much of the selected resource has to be paid to reveal soldier stats."
